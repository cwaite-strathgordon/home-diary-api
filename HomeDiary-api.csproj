    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HomeDiary_api</RootNamespace>
    <UserSecretsId>homediary-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
